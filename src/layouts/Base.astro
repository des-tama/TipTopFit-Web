---
// Kerangka semua halaman: meta SEO, Open Graph, hreflang, JSON-LD, header & footer.
import '@fontsource/lilita-one/400.css';
import '../styles/global.css';
import { site } from '../data/site';
import { t, localePath, type Lang } from '../data/i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path halaman TANPA awalan bahasa, mis. '/' atau '/privacy/'. */
  path: string;
  jsonLd?: object[];
  noindex?: boolean;
}
const { lang, title, description, path, jsonLd = [], noindex = false } = Astro.props;
const s = t[lang];
const other: Lang = lang === 'en' ? 'id' : 'en';
const canonical = new URL(localePath(lang, path), site.url).href;
const alt = (l: Lang) => new URL(localePath(l, path), site.url).href;
const ogImage = new URL('/og-image.jpg', site.url).href;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={s.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {!noindex && <link rel="alternate" hreflang="en" href={alt('en')} />}
    {!noindex && <link rel="alternate" hreflang="id" href={alt('id')} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={alt('en')} />}
    <meta name="theme-color" content="#080614" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={s.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {site.playStoreLive && <meta name="google-play-app" content={`app-id=${site.androidPackage}`} />}

    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip" href="#main">{lang === "id" ? "Lewati ke konten" : "Skip to content"}</a>
    <header class="top">
      <div class="wrap top-in">
        <a class="brand" href={localePath(lang, '/')} aria-label={site.name}>
          <img src="/icon-192.png" width="40" height="40" alt="" />
          <span>{site.name}</span>
        </a>
        <nav aria-label="Main">
          <a href={localePath(lang, '/') + '#features'}>{s.nav.features}</a>
          <a href={localePath(lang, '/') + '#faq'}>{s.nav.faq}</a>
          <a href={localePath(lang, '/privacy/')}>{s.nav.privacy}</a>
          <a class="lang" href={localePath(other, path)} hreflang={other} lang={other}>{s.nav.language}</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot-in">
        <p>© {year} {site.name}. {s.footer.rights}</p>
        <p class="foot-links">
          <a href={localePath(lang, '/privacy/')}>{s.nav.privacy}</a>
          <a href={localePath(lang, '/terms/')}>{s.footer.terms}</a>
          <a href={localePath(lang, '/delete-account/')}>{s.footer.del}</a>
          <a href={`mailto:${site.contactEmail}`}>{s.footer.contact}</a>
        </p>
      </div>
    </footer>
  </body>
</html>
